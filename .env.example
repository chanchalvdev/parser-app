# Core compose/project settings
COMPOSE_PROJECT_NAME=enterprise-file-platform
ENV=local
APP_ENV=local

# PostgreSQL
POSTGRES_DB=file_platform
POSTGRES_USER=file_user
POSTGRES_PASSWORD=file_password
DATABASE_URL=postgres://file_user:file_password@postgres:5432/file_platform?sslmode=disable
API_PORT=8080

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_NAME=ingestion_jobs
WORKER_QUEUE_NAME=ingestion_jobs
WORKER_REDIS_BLOCK_TIMEOUT=5
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_MAX_ARCHIVE_DEPTH=10
WORKER_MAX_EXTRACTED_FILES=10000
WORKER_MAX_EXTRACTED_SIZE_MB=1024
WORKER_MAX_EXPANSION_RATIO=20.0
WORKER_TEMP_DIR=/tmp/file-worker
WORKER_LOG_LEVEL=INFO

# MinIO / S3-compatible storage
MINIO_ENDPOINT=minio:9000
MINIO_PRESIGN_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=file-ingestion
MINIO_USE_SSL=false

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_SERVICE_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=K8g9!vQ2pX4tR1z8
OPENSEARCH_INITIAL_ADMIN_PASSWORD=K8g9!vQ2pX4tR1z8
OPENSEARCH_INDEX=parsed-documents
OPENSEARCH_PARSED_RECORDS_INDEX=parsed-records
OPENSEARCH_FILES_INDEX=files
OPENSEARCH_DASHBOARDS_URL=http://opensearch-dashboards:5601

# API
API_LISTEN_ADDR=:8080
API_KEY=change-me
AUTH_ENABLED=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=5120
UPLOAD_PATH_PREFIX=uploads

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_KEY=
